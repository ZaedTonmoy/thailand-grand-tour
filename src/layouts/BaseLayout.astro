---
const { title = "Thailand, Unfiltered", description = "Zaed's Thailand grand tour, 15 December 2026 – 4 January 2027." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#102b27">
<meta name="description" content={description}><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<style is:global>
:root{--ink:#172b28;--deep:#102b27;--cream:#f5f2e9;--paper:#fffdf7;--muted:#66736c;--lime:#d9f078;--line:#e4e4d9}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:82px}body{margin:0;background:var(--cream);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.6}a{color:inherit}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}.nav{position:sticky;top:0;z-index:5;background:#f5f2e9ed;backdrop-filter:blur(12px);border-bottom:1px solid #172b2812}.navin{height:70px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-weight:700;letter-spacing:-.04em;text-decoration:none}.brand span{color:#64804b}.navlinks{display:flex;gap:22px;font-size:.86rem;color:var(--muted)}.navlinks a{text-decoration:none}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:12px 18px;background:var(--lime);color:var(--deep);text-decoration:none;font-weight:700}.btn.ghost{background:#ffffff15;border:1px solid #ffffff80;color:white}.hero{padding:28px 0 58px}.heroimg{min-height:590px;border-radius:26px;overflow:hidden;position:relative;background:#16332b url('https://images.unsplash.com/photo-1508009603885-50cf7c579365?auto=format&fit=crop&w=2000&q=85') center/cover;display:flex;align-items:flex-end;color:white}.heroimg:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#091d1be8,#091d1b8a 48%,#091d1b08),linear-gradient(0deg,#091d1b70,transparent 50%)}.herotext{position:relative;padding:clamp(26px,6vw,72px);max-width:820px}.eyebrow,.label{font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#6a8150}.eyebrow{color:var(--lime)}h1,h2,h3{font-family:"Playfair Display",serif}h1{font-size:clamp(3.4rem,8vw,6.7rem);line-height:.96;letter-spacing:-.055em;margin:20px 0}h1 em{color:var(--lime)}.hero p{max-width:570px;color:#f0f0e8;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}.stat,.place,.day,.info,.activity,.budgetlist{background:var(--paper);border:1px solid var(--line);border-radius:18px}.stat{padding:18px}.stat strong{display:block;font-size:1.4rem}.stat span{font-size:.8rem;color:var(--muted)}section{padding:58px 0}.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:26px}.sectionhead h2{font-size:clamp(2.2rem,4.5vw,3.5rem);line-height:1.04;letter-spacing:-.04em;margin:8px 0 0}.sectionhead p{max-width:470px;color:var(--muted);margin:0}.routegrid,.activitygrid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.place,.activity{overflow:hidden}.place img{width:100%;height:205px;object-fit:cover;display:block}.placebody,.inside{padding:19px}.place h3{font-size:1.55rem;margin:4px 0}.place p,.activity p{font-size:.9rem;color:var(--muted)}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{background:#edf0e4;color:#44563d;padding:5px 9px;border-radius:999px;font-size:.72rem;font-weight:700}.highlight{background:var(--deep);color:white;border-radius:24px;padding:clamp(24px,5vw,52px);display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center}.highlight h2{font-size:clamp(2.4rem,5vw,4rem);line-height:1.03;margin:15px 0}.highlight p{color:#d5ded5}.highlight img{width:100%;height:300px;object-fit:cover;border-radius:16px}.timeline{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.day{display:grid;grid-template-columns:80px 1fr;gap:14px;padding:14px}.date{background:var(--deep);color:white;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:78px}.date strong{font-size:1.4rem;line-height:1.1}.date span{font-size:.68rem;color:var(--lime);letter-spacing:.08em}.day small{color:#66804c;font-weight:700}.day h3{font:700 1rem "DM Sans",sans-serif;margin:3px 0}.day p{font-size:.86rem;color:var(--muted);margin:0}.activity img{width:100%;height:180px;object-fit:cover;display:block}.activity h3{font-size:1.28rem;margin:0}.price{font-size:.83rem;color:#58743f;font-weight:700}.safety{background:#fff3e9;border:1px solid #f2d5c2;border-radius:16px;padding:20px;margin-top:16px}.safety p{margin-bottom:0;color:#6c594f;font-size:.9rem}.budget{display:grid;grid-template-columns:.9fr 1.1fr;gap:18px}.budgethero{background:var(--lime);border-radius:20px;padding:28px}.amount{font-size:clamp(2.7rem,6vw,4.3rem);font-weight:700;letter-spacing:-.07em;line-height:1.1;margin:18px 0}.budgethero p{color:#44533d}.budgetlist{padding:22px}.budgetrow{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-bottom:1px solid var(--line);font-size:.9rem}.budgetrow span:last-child{font-weight:700;white-space:nowrap}.budgetrow:last-of-type{border-bottom:0}.note,.tiny{font-size:.8rem;color:var(--muted)}.practical{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.info{padding:22px}.info h3{font-size:1.3rem;margin-top:0}.info li,.info p{font-size:.9rem;color:var(--muted)}.linklist{display:flex;gap:8px;flex-wrap:wrap}.linklist a{font-size:.8rem;font-weight:700;text-decoration:none;padding:9px 12px;background:#edf0e4;border-radius:999px}.checklist{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:16px}.check{display:flex;gap:10px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--paper);font-size:.9rem}.check input{accent-color:#526e3d;margin-top:5px}.footer{background:var(--deep);color:white;padding:36px 0;margin-top:35px}.footerin{display:flex;justify-content:space-between;gap:20px}.footer p{font-size:.8rem;color:#bac8bd;margin:4px 0}.toplink{color:var(--lime);text-decoration:none;font-weight:700}@media(max-width:800px){.navlinks{display:none}.stats{grid-template-columns:repeat(2,1fr)}.routegrid,.activitygrid{grid-template-columns:repeat(2,1fr)}.timeline{grid-template-columns:1fr}.highlight,.budget{grid-template-columns:1fr}.sectionhead{align-items:start;flex-direction:column}.practical{grid-template-columns:1fr}}@media(max-width:520px){.heroimg{min-height:570px}.herotext{padding:23px}.routegrid,.activitygrid{grid-template-columns:1fr}.place img{height:225px}.day{grid-template-columns:70px 1fr;gap:10px;padding:11px}.checklist{grid-template-columns:1fr}.footerin{flex-direction:column}section{padding:44px 0}} 
</style>
</head><body><slot /></body></html>