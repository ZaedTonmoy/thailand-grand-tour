  </head>
  <body id="top">
    <!-- STICKY TOPBAR -->
    <div class="topbar-wrap">
      <div class="topbar container">
        <a href="#top" class="brand">THAILAND<span>, UNFILTERED.</span></a>
        <nav class="nav-links">
          <a href="#itinerary">Daily plan</a>
          <a href="#expenses">Expense logger</a>
