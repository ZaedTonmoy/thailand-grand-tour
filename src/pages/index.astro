          <a href="#stays">Hostels</a>
          <a href="#emergency">Emergency &amp; tips</a>
        </nav>
        <div class="topbar-pills">
          <a href="#expenses" class="nav-wallet-pill" id="top-wallet-pill">৳160.4k left</a>
          <a href="#checklist" class="nav-cta" id="top-progress-pill">Checklist · 0/30</a>
        </div>
      </div>
    </div>

    <!-- LIVE "TODAY IS DAY X" JUMP BANNER -->
