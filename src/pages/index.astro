          <div class="emg-contact-card">
            <div class="emg-icon">🚑</div>
            <div class="emg-info">
              <h3>Medical Emergency &amp; Ambulance</h3>
              <p class="emg-phone"><a href="tel:1669">1669</a></p>
              <small>National medical emergency dispatch (General Police: 191).</small>
            </div>
