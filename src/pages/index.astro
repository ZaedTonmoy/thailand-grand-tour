      h2 {
        font-size: clamp(1.85rem, 3.5vw, 2.65rem);
      }

      .section-sub {
        max-width: 540px;
        color: var(--muted);
        font-size: 0.94rem;
      }

      /* Route Grid */
      .route-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
