---
import BaseLayout from "../layouts/BaseLayout.astro";
const places = [
{name:"Bangkok",dates:"15–16 Dec · 30 Dec–3 Jan",image:"https://images.unsplash.com/photo-1508009603885-50cf7c579365?auto=format&fit=crop&w=1000&q=85",alt:"Bangkok city",desc:"River temples, Chinatown street food, rooftop views and New Year's Eve.",tags:["Street food","Temples","NYE"]},
{name:"Phuket",dates:"17–20 December",image:"https://images.unsplash.com/photo-1589394815804-964ed0be2eb5?auto=format&fit=crop&w=1000&q=85",alt:"Phuket beach",desc:"Three days around EDC Thailand, plus beach time and Phuket Old Town.",tags:["EDC Thailand","Beach","Nightlife"]},
{name:"Krabi",dates:"21–23 December",image:"https://images.unsplash.com/photo-1516690561799-46d8f74f9abf?auto=format&fit=crop&w=1000&q=85",alt:"Krabi islands",desc:"Limestone cliffs, longtail boats, island-hopping and snorkelling.",tags:["Island tour","Kayak","Snorkel"]},
{name:"Khao Sok",dates:"24–25 December",image:"https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=1000&q=85",alt:"Tropical rainforest",desc:"Rainforest trails and Cheow Lan Lake; consider one floating-bungalow night.",tags:["Jungle","Lake","Wildlife"]},
{name:"Chiang Mai",dates:"26–29 December",image:"https://images.unsplash.com/photo-1512553353614-82a7370096dc?auto=format&fit=crop&w=1000&q=85",alt:"Chiang Mai temple",desc:"Old City temples, an ethical elephant experience and mountain day trips.",tags:["Culture","Elephants","Mountains"]},
{name:"Ayutthaya",dates:"2 January day trip",image:"https://images.unsplash.com/photo-1598970605070-a38a6ccd6a1d?auto=format&fit=crop&w=1000&q=85",alt:"Ayutthaya ruins",desc:"The former royal capital, atmospheric temple ruins and history.",tags:["History","Day trip","Photos"]}
];
const days = [
["TUE","15","DEC","BANGKOK","Arrive & ease in","Fly Dhaka → Bangkok, check in, explore Chinatown and have a relaxed first dinner."],
["WED","16","DEC","BANGKOK","River temples","Grand Palace, Wat Pho, Wat Arun and a Chao Phraya riverside evening."],
["THU","17","DEC","PHUKET","Fly south","Travel to Phuket, check your EDC transport plan and catch a beach sunset."],
["FRI","18","DEC","EDC · PHUKET","EDC Thailand — day 1","Festival day. Confirm ticket validity, gates, shuttle details and return transport."],
["SAT","19","DEC","EDC · PHUKET","EDC Thailand — day 2","Eat, hydrate and keep the daytime schedule flexible before the festival."],
["SUN","20","DEC","EDC · PHUKET","EDC Thailand — day 3","Final festival day. Avoid an early departure the next morning."],
["MON","21","DEC","KRABI","Travel to Ao Nang","Transfer to Krabi, check in and have a low-key evening."],
["TUE","22","DEC","KRABI","Island day","Book a reputable Four Islands or Hong Islands trip, weather permitting."],
["WED","23","DEC","KRABI","Railay & water time","Visit Railay Beach; consider kayaking or a relaxed beach day."],
["THU","24","DEC","KHAO SOK","Into the rainforest","Travel to Khao Sok village and arrange a guided nature outing."],
["FRI","25","DEC","CHEOW LAN LAKE","Lake adventure","Boat across Cheow Lan Lake; a floating stay is an optional splurge."],
["SAT","26","DEC","TRANSFER DAY","South → Chiang Mai","Long transfer day. Confirm road transfers and flight connections before booking."],
["SUN","27","DEC","CHIANG MAI","Old City & Doi Suthep","Explore temples and markets; visit Doi Suthep if time and weather allow."],
["MON","28","DEC","CHIANG MAI","Elephant sanctuary","Choose a welfare-focused sanctuary; avoid riding and forced performances."],
["TUE","29","DEC","CHIANG MAI","Doi Inthanon","Full-day mountain and waterfall trip; bring a light layer."],
["WED","30","DEC","BANGKOK","Fly back to Bangkok","Return by flight and settle into your Bangkok hostel."],
["THU","31","DEC","BANGKOK","New Year's Eve","Choose an official countdown venue and plan a safe route home."],
["FRI","01","JAN","BANGKOK","Slow New Year's Day","Sleep in, eat well, wander a riverside neighbourhood or mall."],
["SAT","02","JAN","AYUTTHAYA","Ancient capital day trip","Visit temple ruins on a guided or train-based day trip."],
["SUN","03","JAN","BANGKOK","Choose your finale","Food crawl, shopping, cooking class or a pre-booked activity."],
["MON","04","JAN","DEPARTURE","Return to Dhaka","Leave a generous buffer for airport traffic and check-in."]
];
const costs = [["International flights","৳45,000"],["Visa / entry allowance","৳8,000"],["Hostels & one special stay","৳40,000"],["Domestic transport & transfers","৳38,000"],["Food & drinks","৳30,000"],["EDC ticket allowance","৳38,000"],["Tours & activities","৳40,000"],["SIM, insurance & incidentals","৳12,000"],["Contingency reserve","৳47,000"]];
---
<BaseLayout title="Thailand, Unfiltered — Zaed's Grand Tour">
<div class="nav"><div class="wrap navin"><a class="brand" href="#top">THAILAND<span>, UNFILTERED.</span></a><nav class="navlinks"><a href="#route">Route</a><a href="#itinerary">Itinerary</a><a href="#experiences">Experiences</a><a href="#budget">Budget</a><a href="#essentials">Essentials</a></nav><a class="btn" href="#itinerary">Explore trip ↗</a></div></div>
<main id="top">
<header class="hero wrap"><div class="heroimg"><div class="herotext"><span class="btn" style="padding:8px 12px;font-size:.78rem">SOLO TRIP · 15 DEC 2026 — 4 JAN 2027</span><div class="eyebrow" style="margin-top:25px">One trip. Two coasts. A thousand stories.</div><h1>Thailand,<br><em>unfiltered.</em></h1><p>Bangkok's neon nights, Phuket's festival pulse, Krabi's limestone islands, Khao Sok's emerald lake and Chiang Mai's mountain air. Built for adventure, food and meeting people along the way.</p><div class="actions"><a class="btn" href="#route">See the route ↓</a><a class="btn ghost" href="https://edcthailand.frontgatetickets.com/" target="_blank" rel="noreferrer">EDC ticket desk ↗</a></div></div></div><div class="stats"><div class="stat"><strong>21 days</strong><span>15 Dec – 4 Jan inclusive</span></div><div class="stat"><strong>20 nights</strong><span>Mostly hostel stays</span></div><div class="stat"><strong>৳250–350k</strong><span>Target total budget</span></div><div class="stat"><strong>5 regions</strong><span>City, coast, jungle & north</span></div></div></header>
<section id="route" class="wrap"><div class="sectionhead"><div><div class="label">The grand loop</div><h2>Six stops.<br>One big adventure.</h2></div><p>A route that balances the festival, beaches, rainforest and northern mountains, then returns to Bangkok for New Year's Eve and your flight home.</p></div><div class="routegrid">{places.map(p=><article class="place"><img src={p.image} alt={p.alt} loading="lazy"><div class="placebody"><div class="label">{p.dates}</div><h3>{p.name}</h3><p>{p.desc}</p><div class="chips">{p.tags.map(tag=><span class="chip">{tag}</span>)}</div></div></article>)}</div></section>
<section class="wrap"><div class="highlight"><div><div class="eyebrow">18–20 December · Phuket</div><h2>Three days of electric energy.</h2><p>EDC is the anchor of the southern leg. Buy through official ticketing, confirm current availability and entry rules, and check transport before choosing your hostel.</p><div class="actions"><a class="btn" href="https://edcthailand.frontgatetickets.com/" target="_blank" rel="noreferrer">Check official tickets ↗</a><a class="btn ghost" href="https://thailand.edc.com/en/" target="_blank" rel="noreferrer">Festival info ↗</a></div><p class="tiny" style="color:#bdc9bf">Ticket stock and prices change. Confirm at checkout before booking non-refundable stays.</p></div><img src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?auto=format&fit=crop&w=1200&q=85" alt="Electronic music festival crowd and lights" loading="lazy"></div></section>
<section id="itinerary" class="wrap"><div class="sectionhead"><div><div class="label">Day by day</div><h2>A plan, not a prison.</h2></div><p>Travel days are intentionally lighter. Weather can change boat tours and mountain plans, so keep some flexibility.</p></div><div class="timeline">{days.map(d=><article class="day"><div class="date"><span>{d[0]}</span><strong>{d[1]}</strong><span>{d[2]}</span></div><div><small>{d[3]}</small><h3>{d[4]}</h3><p>{d[5]}</p></div></article>)}</div></section>
<section id="experiences" class="wrap"><div class="sectionhead"><div><div class="label">Worth making time for</div><h2>Big memories,<br>smart choices.</h2></div><p>Pick a few standout experiences. Confirm operators, inclusions, cancellation rules and transport before paying.</p></div><div class="activitygrid">
<article class="activity"><img src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=900&q=85" alt="Island sea and beach" loading="lazy"><div class="inside"><h3>Island hopping</h3><p>Krabi's limestone islands and snorkelling, with weather-dependent departures.</p><span class="price">Allowance: ฿900–2,000</span></div></article>
<article class="activity"><img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=85" alt="Green mountain landscape" loading="lazy"><div class="inside"><h3>Jungle & lake</h3><p>Explore Khao Sok with a licensed guide; compare village stays and lake packages.</p><span class="price">Price varies by package</span></div></article>
<article class="activity"><img src="https://images.unsplash.com/photo-1552550049-db0e9b6b6a3f?auto=format&fit=crop&w=900&q=85" alt="Elephant in green habitat" loading="lazy"><div class="inside"><h3>Elephant sanctuary</h3><p>Prioritise welfare transparency, observation and natural behaviour over riding or forced contact.</p><span class="price">Compare ethical operators</span></div></article>
<article class="activity"><img src="https://images.unsplash.com/photo-1512553353614-82a7370096dc?auto=format&fit=crop&w=900&q=85" alt="Northern Thailand temple" loading="lazy"><div class="inside"><h3>Temples & culture</h3><p>Dress respectfully at sacred sites and follow local photography rules.</p><span class="price">Some temples charge entry</span></div></article>
<article class="activity"><img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=900&q=85" alt="Thai food spread" loading="lazy"><div class="inside"><h3>Eat your way around</h3><p>Street-food crawls, night markets, northern dishes and a cooking class.</p><span class="price">Keep a daily food budget</span></div></article>
<article class="activity"><img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=900&q=85" alt="Concert lights at night" loading="lazy"><div class="inside"><h3>Nightlife & countdown</h3><p>Choose a New Year's Eve venue early and plan a safe trip back.</p><span class="price">Entry and transport vary</span></div></article>
</div><div class="safety"><strong>Wildlife note</strong><p>Don't treat tiger-contact photo attractions as a must-do. Close contact with large predators carries real risk and raises animal-welfare concerns. Prefer reputable observation-led wildlife experiences.</p></div></section>
<section id="budget" class="wrap"><div class="sectionhead"><div><div class="label">Money plan</div><h2>Spend on stories,<br>save on beds.</h2></div><p>Hostels can keep the total under control, but Christmas, New Year's Eve, festival nights and lake stays can push prices up.</p></div><div class="budget"><div class="budgethero"><div class="label">Target trip budget</div><div class="amount">৳250–350k</div><p>Working range for flights, entry allowance, beds, transport, food, EDC and activities. Planning estimate, not a live quote.</p><a class="btn" href="https://www.hostelworld.com/" target="_blank" rel="noreferrer">Compare hostels ↗</a></div><div class="budgetlist">{costs.map(c=><div class="budgetrow"><span>{c[0]}</span><span>{c[1]}</span></div>)}<p class="note">Provisional figures can exceed the target depending on flights, ticket tier and tours. Reprice before booking. Verify visa and entry rules for Bangladeshi passport holders using official sources.</p></div></div></section>
<section id="essentials" class="wrap"><div class="sectionhead"><div><div class="label">Before you go</div><h2>Small details.<br>Huge difference.</h2></div><p>Tick items off as you prepare. Book refundable beds early, then confirm transport and tours.</p></div><div class="practical"><article class="info"><h3>Where to stay</h3><ul><li>Bangkok: Old Town or Chinatown for food and temples.</li><li>Phuket: choose by confirmed EDC transport, not beach proximity alone.</li><li>Krabi: Ao Nang for tours and restaurants.</li><li>Khao Sok: village guesthouse plus optional lake package.</li><li>Chiang Mai: Old City for walkability and social hostels.</li></ul><p>Check recent reviews, air-conditioning, lockers, cancellation terms and late check-in policy.</p></article><article class="info"><h3>Useful official links</h3><div class="linklist"><a href="https://edcthailand.frontgatetickets.com/" target="_blank" rel="noreferrer">EDC tickets ↗</a><a href="https://thailand.edc.com/en/" target="_blank" rel="noreferrer">EDC Thailand ↗</a><a href="https://www.tourismthailand.org/" target="_blank" rel="noreferrer">Tourism Authority ↗</a><a href="https://www.thaievisa.go.th/" target="_blank" rel="noreferrer">Thai e-Visa ↗</a><a href="https://www.hostelworld.com/" target="_blank" rel="noreferrer">Hostelworld ↗</a><a href="https://www.booking.com/" target="_blank" rel="noreferrer">Booking.com ↗</a></div><p>Check visa eligibility and any required arrival registration through official Thai government sources close to departure.</p></article></div><div class="checklist">{["Passport validity checked","Visa / entry requirements verified","EDC ticket purchased from official seller","Phuket transport plan confirmed","Refundable hostel beds reserved","Travel insurance purchased","Domestic flights and transfer times checked","Cash, card and eSIM plan ready"].map(item=><label class="check"><input type="checkbox"><span>{item}</span></label>)}</div></section>
</main><footer class="footer"><div class="wrap footerin"><div><strong>THAILAND, UNFILTERED.</strong><p>Built for Zaed · December 2026 – January 2027 · Astro</p><p>Photos load from Unsplash. Verify details before booking.</p></div><a class="toplink" href="#top">Back to top ↑</a></div></footer>
</BaseLayout>