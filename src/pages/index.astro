        font-weight: 800;
        letter-spacing: 0.06em;
        color: var(--text);
        text-decoration: none;
        font-size: 0.95rem;
      }

      .brand span {
        color: var(--accent);
      }

      .nav-links {
        display: flex;
        gap: 1.15rem;
        flex-wrap: wrap;
      }

      .nav-links a {
