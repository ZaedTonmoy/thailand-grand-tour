      .filter-meta-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding-top: 0.65rem;
        border-top: 1px solid var(--border);
        font-size: 0.84rem;
        color: var(--muted);
      }

      .filter-view-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .util-btn {
        background: var(--bg-card);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 0.42rem 0.85rem;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
      }

      .util-btn:hover {
        border-color: rgba(245, 158, 11, 0.45);
      }

      .util-btn.active {
        background: var(--emerald-soft);
        color: var(--emerald);
        border-color: var(--emerald);
      }

      .util-btn.danger-btn:hover {
        background: var(--danger-soft);
        color: var(--danger);
        border-color: rgba(248, 113, 113, 0.45);
      }

      /* Days List */
      .days-list {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
      }

      .day-card {
        display: grid;
        grid-template-columns: 98px 1fr;
        gap: 1.4rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 1.5rem;
        transition: opacity 0.2s, border-color 0.2s;
      }

      .day-card.day-is-completed {
        border-color: rgba(52, 211, 153, 0.4);
        background: rgba(20, 29, 24, 0.75);
      }

      .day-card.day-is-completed h3 {
        text-decoration: line-through;
        color: var(--muted);
      }

      .day-date-col {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 0.45rem;
        height: fit-content;
        text-align: center;
        gap: 0.15rem;
      }

      .day-date-col span {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .day-date-col strong {
        font-family: "Fraunces", serif;
        font-size: 1.95rem;
        line-height: 1.05;
        color: var(--accent);
      }

      .day-done-btn {
        margin-top: 0.45rem;
        background: rgba(255, 255, 255, 0.06);
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
      }

      .day-card.day-is-completed .day-done-btn {
        background: var(--emerald-soft);
        color: var(--emerald);
        border-color: var(--emerald);
      }

      .day-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        font-size: 0.8rem;
        color: var(--accent);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
      }

      .day-meta-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .city-chip {
        background: var(--accent-soft);
        color: var(--accent);
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
      }

      .day-body-col h3 {
        font-size: 1.45rem;
        margin-bottom: 0.45rem;
      }

      .stay-actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }

      .stay-pill {
        display: inline-block;
        font-size: 0.84rem;
        color: var(--emerald);
        background: var(--emerald-soft);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      .day-action-chips {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }

      .chip-action-btn {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s;
      }

      .chip-action-btn.maps-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .chip-action-btn.thai-btn:hover {
        border-color: var(--emerald);
        color: var(--emerald);
      }

      /* Driver Thai Script Card */
      .driver-thai-card {
        background: #111a14;
        border: 2px solid var(--emerald);
        border-radius: 14px;
        padding: 1.15rem;
        margin-bottom: 1.1rem;
      }

      .driver-thai-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.6rem;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--emerald);
      }

      .close-thai-btn {
        background: transparent;
        border: none;
        color: var(--muted);
        font-size: 1rem;
        cursor: pointer;
      }

      .driver-thai-text {
        font-family: "Noto Sans Thai", sans-serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.3;
        margin-bottom: 0.45rem;
        letter-spacing: 0.02em;
      }

      .driver-phonetic {
        font-size: 0.85rem;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .driver-instruction {
        font-size: 0.82rem;
        color: var(--muted);
      }

      .time-blocks {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(225px, 1fr));
        gap: 0.95rem;
        margin-bottom: 1.15rem;
      }

      .time-slot {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        padding: 0.95rem;
        border-radius: 12px;
      }

      .time-slot b {
        display: block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 0.3rem;
      }

      .time-slot p {
        font-size: 0.88rem;
        color: var(--text);
      }

      .day-footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1.4fr;
        gap: 1rem;
        padding-top: 0.95rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }

      .day-footer-grid b {
        display: block;
        color: var(--text);
        margin-bottom: 0.18rem;
      }

      .day-footer-grid span,
      .day-footer-grid p {
        color: var(--muted);
      }

      /* Inline Actual Spend Bar on Day Cards */
      .day-inline-expense-bar {
        display: grid;
        grid-template-columns: 220px 1fr auto;
        align-items: end;
        gap: 0.85rem;
        background: rgba(20, 26, 22, 0.9);
        border: 1px dashed rgba(245, 158, 11, 0.35);
        padding: 0.85rem 1rem;
        border-radius: 12px;
      }

      .inline-exp-field label,
      .inline-exp-note-field label {
        display: block;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        margin-bottom: 0.3rem;
      }

      .inline-input-wrap {
        display: flex;
        align-items: center;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0 0.6rem;
      }

      .inline-input-wrap:focus-within {
        border-color: var(--accent);
      }

      .curr-prefix {
        color: var(--accent);
        font-weight: 700;
        font-size: 0.88rem;
        margin-right: 0.35rem;
      }

      .inline-input-wrap input,
      .day-note-input,
      .ledger-note-input {
        width: 100%;
        background: transparent;
        border: none;
        color: var(--text);
        font-family: inherit;
        font-size: 0.88rem;
        padding: 0.45rem 0;
        outline: none;
      }

      .day-note-input,
      .ledger-note-input {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.45rem 0.65rem;
      }

      .inline-exp-status {
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.45rem 0.8rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--muted);
        white-space: nowrap;
      }

      .inline-exp-status.good {
        background: var(--emerald-soft);
        color: var(--emerald);
      }

      .inline-exp-status.over {
        background: var(--danger-soft);
        color: var(--danger);
      }

      /* Compact Mode for Phone */
      .days-list.compact-mode .time-blocks,
      .days-list.compact-mode .booking-tip-box,
      .days-list.compact-mode .driver-thai-card {
        display: none !important;
      }

      .days-list.compact-mode .day-card {
        padding: 1rem 1.2rem;
      }

      .days-list.compact-mode .day-footer-grid {
        grid-template-columns: 1fr 1fr;
        padding-top: 0.5rem;
      }

      /* EXPENSE LOGGER SECTION */
      .exp-dashboard {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.4rem;
      }

      .exp-controls-row {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 1.2rem;
        align-items: end;
        padding-bottom: 1.35rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 1.35rem;
      }

      .exp-control-group label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .exp-control-group small {
        display: block;
        font-size: 0.76rem;
        color: var(--muted);
        margin-top: 0.3rem;
      }

      .exp-control-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-self: center;
      }

      .exp-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
        margin-bottom: 1.3rem;
      }

      .exp-kpi-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.15rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .exp-kpi-card.highlight-kpi {
        border-color: rgba(52, 211, 153, 0.45);
        background: linear-gradient(155deg, rgba(20, 35, 28, 0.9), rgba(20, 25, 22, 0.9));
      }

      .exp-kpi-card.over-budget-card {
        border-color: rgba(248, 113, 113, 0.5);
        background: linear-gradient(155deg, rgba(40, 20, 20, 0.9), rgba(20, 25, 22, 0.9));
      }

      .kpi-label {
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
        font-weight: 700;
      }

      .kpi-val {
        font-family: "Fraunces", serif;
        font-size: 1.7rem;
        color: var(--text);
      }

      .emerald-text {
        color: var(--emerald);
      }

      .danger-text {
        color: var(--danger);
      }

      .kpi-sub {
        font-size: 0.8rem;
        color: var(--muted);
      }

      .exp-meter-labels {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.82rem;
        color: var(--muted);
        margin-bottom: 0.45rem;
      }

      .exp-subcard {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.4rem;
        margin-bottom: 1.4rem;
      }

      .exp-subcard-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.15rem;
      }

      .exp-subcard-head h3 {
        font-size: 1.25rem;
        margin-bottom: 0.2rem;
      }

      .exp-subcard-head p {
        font-size: 0.86rem;
        color: var(--muted);
      }

      .toggle-fixed-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--accent);
        cursor: pointer;
      }

      .fixed-costs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
      }

      .fixed-cost-item {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        padding: 1rem;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .fixed-cost-item label {
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--text);
      }

      .fixed-cost-item small {
        font-size: 0.76rem;
        color: var(--muted);
        margin-bottom: 0.35rem;
      }

      .bdt-inline-Readout {
        font-size: 0.78rem;
        color: var(--muted);
        white-space: nowrap;
        padding-left: 0.5rem;
      }

      .ledger-sub-title {
        font-size: 0.8rem;
        color: var(--muted);
        margin-top: 0.15rem;
      }

      .compact-input {
        width: 115px;
      }

      .muted-cell {
        color: var(--muted);
        font-size: 0.82rem;
      }

      .status-pill {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
      }

      .status-pill.neutral {
        background: rgba(255, 255, 255, 0.06);
        color: var(--muted);
      }

      .status-pill.good {
        background: var(--emerald-soft);
        color: var(--emerald);
      }

      .status-pill.over {
        background: var(--danger-soft);
        color: var(--danger);
      }

      /* Interactive Checklist Section */
      .checklist-dashboard {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.35rem;
        margin-bottom: 1.25rem;
      }

      .chk-progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.85rem;
      }

      .chk-progress-header strong {
        display: block;
        font-family: "Fraunces", serif;
        font-size: 1.35rem;
        color: var(--text);
      }

      .chk-progress-header span {
        font-size: 0.84rem;
        color: var(--muted);
      }

      .chk-dashboard-actions {
        display: flex;
        gap: 0.5rem;
      }

      .progress-track {
        width: 100%;
        height: 12px;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1.1rem;
      }

      .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), var(--emerald));
        border-radius: 999px;
        transition: width 0.3s ease;
      }

      .progress-fill.over-bar {
        background: linear-gradient(90deg, var(--accent), var(--danger));
      }

      .chk-tabs {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
        scrollbar-width: none;
      }

      .chk-tabs::-webkit-scrollbar {
        display: none;
      }

      .chk-tab {
        background: var(--bg-elevated);
        color: var(--muted);
        border: 1px solid var(--border);
        padding: 0.48rem 0.9rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
      }

      .chk-tab.active {
        background: var(--accent);
        color: #0c0f0d;
        border-color: var(--accent);
        font-weight: 700;
      }

      .chk-list {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      .chk-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1rem 1.15rem;
        cursor: pointer;
        user-select: none;
        transition: border-color 0.15s, background 0.15s;
      }

      .chk-row:hover {
        border-color: rgba(245, 158, 11, 0.35);
      }

      .chk-row.is-checked {
        background: rgba(20, 28, 23, 0.65);
        border-color: rgba(52, 211, 153, 0.3);
      }

      .chk-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .chk-custom-box {
        width: 26px;
        height: 26px;
        min-width: 26px;
        border-radius: 8px;
        border: 2px solid var(--muted);
        background: var(--bg-elevated);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 800;
        color: transparent;
        transition: all 0.15s;
      }

      .chk-row.is-checked .chk-custom-box {
        background: var(--emerald);
        border-color: var(--emerald);
        color: #0c0f0d;
      }

      .chk-content {
        flex: 1;
        min-width: 0;
      }

      .chk-title-line {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        margin-bottom: 0.2rem;
      }

      .chk-cat-tag {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.12rem 0.5rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
      }

      .chk-title {
        font-size: 0.96rem;
        color: var(--text);
      }

      .chk-row.is-checked .chk-title {
        text-decoration: line-through;
        color: var(--muted);
      }

      .chk-meta {
        font-size: 0.83rem;
        color: var(--muted);
      }

      .chk-cost-badge {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        white-space: nowrap;
      }

      /* Hostels Grid */
      .hostels-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
        gap: 1.35rem;
      }

      .hostel-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.45rem;
        display: flex;
        flex-direction: column;
        gap: 0.95rem;
      }

      .hostel-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
      }

      .hostel-dates {
        font-size: 0.76rem;
        color: var(--accent);
        font-weight: 700;
        text-transform: uppercase;
      }

      .hostel-rate {
        background: var(--accent-soft);
        color: var(--accent);
        padding: 0.28rem 0.65rem;
        border-radius: 8px;
        font-size: 0.8rem;
        white-space: nowrap;
      }

      .hostel-picks {
        list-style: none;
        color: var(--muted);
        font-size: 0.88rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .hostel-pick-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.15rem;
      }

      .hostel-pick-title strong {
        color: var(--text);
      }

      .hostel-maps-link {
        font-size: 0.72rem;
        color: var(--accent);
        text-decoration: none;
        background: var(--bg-elevated);
        border: 1px solid rgba(245, 158, 11, 0.3);
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        font-weight: 700;
      }

      .hostel-maps-link:hover {
        background: var(--accent);
        color: #0c0f0d;
      }

      .hostel-rule {
        margin-top: auto;
        background: var(--bg-elevated);
        border-left: 3px solid var(--accent);
        padding: 0.7rem 0.85rem;
        font-size: 0.84rem;
        color: var(--muted);
        border-radius: 6px;
      }

      /* Budget Table */
      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--bg-card);
      }

      .budget-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.88rem;
      }

      .budget-table th,
      .budget-table td {
        padding: 0.95rem 1.1rem;
        border-bottom: 1px solid var(--border);
      }

      .budget-table th {
        background: var(--bg-elevated);
        color: var(--accent);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .num-col {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      .budget-table tfoot td {
        background: rgba(245, 158, 11, 0.1);
        color: var(--text);
        font-size: 0.96rem;
        border-bottom: none;
      }

      /* Booking Order */
      .booking-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.2rem;
      }

      .book-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.45rem;
      }

      .book-step-num {
        font-family: "Fraunces", serif;
        font-size: 1.9rem;
        color: var(--accent);
        margin-bottom: 0.25rem;
      }

      .book-timing {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--emerald);
        margin-bottom: 0.45rem;
        font-weight: 700;
      }

      .book-card h3 {
        font-size: 1.18rem;
        margin-bottom: 0.5rem;
      }

      .book-card p {
        font-size: 0.88rem;
        color: var(--muted);
      }

      /* Emergency Section */
      .emergency-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.2rem;
        margin-bottom: 1.5rem;
      }

      .emg-contact-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.35rem;
        display: flex;
        align-items: center;
        gap: 1.1rem;
      }

      .emg-icon {
        font-size: 2.2rem;
      }

