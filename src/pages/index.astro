    <!-- MOBILE FLOATING BOTTOM APP BAR (5 TABS) -->
    <nav class="mobile-bottom-nav" aria-label="Mobile quick navigation">
      <a href="#itinerary" class="mob-nav-item">
        <span>🗓️</span>
