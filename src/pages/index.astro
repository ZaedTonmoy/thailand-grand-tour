    <footer class="footer container">
      <div>
        <strong>THAILAND, UNFILTERED.</strong> · 15 Dec 2026 – 4 Jan 2027 · Solo Grand Tour
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>

    <!-- CLIENT-SIDE INTERACTIVITY SCRIPT -->
    <script is:inline>
      (function () {
        // Register PWA Service Worker for offline survival in Cheow Lan Lake & Andaman boats
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker
              .register("/thailand-grand-tour/sw.js")
              .catch(() => {});
          });
        }

        const CHK_STORAGE_KEY = "thailand_grand_tour_v2_checks";
        const DAYS_STORAGE_KEY = "thailand_grand_tour_v2_done_days";
        const EXP_STORAGE_KEY = "thailand_grand_tour_v3_expenses";

        function formatNumber(num) {
          return Math.round(num)
            .toString()
            .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        // --- LIVE "TODAY IS DAY X" CALCULATION & QUICK JUMP ---
        const tourDates = {
          "2026-12-15": 1,
          "2026-12-16": 2,
          "2026-12-17": 3,
          "2026-12-18": 4,
          "2026-12-19": 5,
          "2026-12-20": 6,
          "2026-12-21": 7,
          "2026-12-22": 8,
          "2026-12-23": 9,
          "2026-12-24": 10,
          "2026-12-25": 11,
          "2026-12-26": 12,
          "2026-12-27": 13,
          "2026-12-28": 14,
          "2026-12-29": 15,
          "2026-12-30": 16,
          "2026-12-31": 17,
          "2027-01-01": 18,
          "2027-01-02": 19,
          "2027-01-03": 20,
          "2027-01-04": 21
        };

        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, "0");
        const dd = String(today.getDate()).padStart(2, "0");
        const todayKey = `${yyyy}-${mm}-${dd}`;
        const activeDayNum = tourDates[todayKey] || 1;

        const liveTodayText = document.getElementById("live-today-text");
        const liveJumpBtn = document.getElementById("live-jump-btn");
        const dayJumpSelect = document.getElementById("day-jump-select");

        if (tourDates[todayKey]) {
          if (liveTodayText) {
            liveTodayText.innerHTML = `<strong>TODAY: Day ${activeDayNum} of 21</strong> · Ready to roll in Thailand!`;
          }
          if (liveJumpBtn) {
            liveJumpBtn.textContent = `📍 Jump to Today (Day ${activeDayNum}) ↓`;
            liveJumpBtn.setAttribute("data-target-day", `day-${activeDayNum}`);
          }
        } else {
          if (liveTodayText) {
            liveTodayText.innerHTML = `<strong>Trip Timeline:</strong> 15 Dec 2026 – 4 Jan 2027 (Pre-Trip Planning Mode)`;
          }
          if (liveJumpBtn) {
            liveJumpBtn.textContent = "📍 Jump to Day 1 ↓";
            liveJumpBtn.setAttribute("data-target-day", "day-1");
          }
        }

        if (liveJumpBtn) {
          liveJumpBtn.addEventListener("click", () => {
            const targetId = liveJumpBtn.getAttribute("data-target-day") || "day-1";
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
              targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
              targetEl.classList.add("highlight-flash");
              setTimeout(() => targetEl.classList.remove("highlight-flash"), 2000);
            }
          });
        }

        if (dayJumpSelect) {
          dayJumpSelect.addEventListener("change", (e) => {
            const dayId = e.target.value;
            if (dayId) {
              const targetEl = document.getElementById(dayId);
              if (targetEl) {
                targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
                targetEl.classList.add("highlight-flash");
                setTimeout(() => targetEl.classList.remove("highlight-flash"), 2000);
              }
            }
          });
        }

        // --- THAI SCRIPT DRIVER CARDS TOGGLE ---
        document.querySelectorAll("[data-show-thai]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const dayNum = btn.getAttribute("data-show-thai");
            const card = document.getElementById(`thai-card-${dayNum}`);
            if (card) {
              const isHidden = card.style.display === "none";
              card.style.display = isHidden ? "block" : "none";
              btn.textContent = isHidden ? "🇹🇭 Hide Thai" : "🇹🇭 Show Driver";
            }
          });
        });

        document.querySelectorAll("[data-close-thai]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const dayNum = btn.getAttribute("data-close-thai");
            const card = document.getElementById(`thai-card-${dayNum}`);
            const showBtn = document.querySelector(`[data-show-thai="${dayNum}"]`);
            if (card) card.style.display = "none";
            if (showBtn) showBtn.textContent = "🇹🇭 Show Driver";
          });
        });

        // --- EXPENSE LOGGER STATE & INITIALIZATION ---
        let expState = {
          targetBDT: 320000,
          rate: 3.67,
          includeFixed: true,
          fixed: {
            "fix-intl-flight": 13000,
            "fix-dom-transit": 6800,
            "fix-edc-pass": 10500,
            "fix-hostels": 13200
          },
          dailyTHB: {},
          dailyNotes: {}
        };

        try {
          const savedExp = JSON.parse(localStorage.getItem(EXP_STORAGE_KEY) || "null");
          if (savedExp && typeof savedExp === "object") {
            expState = Object.assign({}, expState, savedExp);
            expState.fixed = Object.assign({}, expState.fixed, savedExp.fixed || {});
            expState.dailyTHB = Object.assign({}, savedExp.dailyTHB || {});
            expState.dailyNotes = Object.assign({}, savedExp.dailyNotes || {});
          }
        } catch (e) {}

        function saveExpState() {
          try {
            localStorage.setItem(EXP_STORAGE_KEY, JSON.stringify(expState));
          } catch (e) {}
        }

        // --- ITINERARY CITY FILTER & COMPLETED DAYS ---
        const filterPills = document.querySelectorAll("[data-city-filter]");
        const jumpButtons = document.querySelectorAll("[data-jump-btn]");
        const dayCards = document.querySelectorAll(".day-card");
        const summaryEl = document.getElementById("itinerary-filter-summary");
        const compactBtn = document.getElementById("toggle-compact-btn");
        const hideCompletedDaysBtn = document.getElementById("hide-completed-days-btn");
        const daysContainer = document.getElementById("days-container");

        let currentCityFilter = "all";
        let hideCompletedDays = false;
        let doneDays = {};

        try {
          doneDays = JSON.parse(localStorage.getItem(DAYS_STORAGE_KEY) || "{}");
        } catch (e) {
          doneDays = {};
        }

        function saveDoneDays() {
          try {
            localStorage.setItem(DAYS_STORAGE_KEY, JSON.stringify(doneDays));
          } catch (e) {}
        }

        function updateItineraryView() {
          let visibleCount = 0;
          let minSum = 0;
          let maxSum = 0;
          let loggedCityTHB = 0;

          dayCards.forEach((card) => {
            const dayId = card.getAttribute("data-day-id");
            const dayNum = card.getAttribute("data-day-num");
            const citiesAttr = (card.getAttribute("data-cities") || "").split(" ");
            const minSpend = parseInt(card.getAttribute("data-min-spend") || "0", 10);
            const maxSpend = parseInt(card.getAttribute("data-max-spend") || "0", 10);
            const isDone = !!doneDays[dayId];

            card.classList.toggle("day-is-completed", isDone);
            const doneBtn = card.querySelector("[data-complete-day]");
            if (doneBtn) {
              doneBtn.textContent = isDone ? "✓ Completed" : "✓ Done";
            }

            const matchesCity =
              currentCityFilter === "all" || citiesAttr.indexOf(currentCityFilter) !== -1;
            const matchesDoneFilter = !hideCompletedDays || !isDone;

            if (matchesCity && matchesDoneFilter) {
              card.style.display = "";
              visibleCount++;
              minSum += minSpend;
              maxSum += maxSpend;
              const actualVal = parseFloat(expState.dailyTHB[dayNum]);
              if (!isNaN(actualVal) && actualVal > 0) {
                loggedCityTHB += actualVal;
              }
            } else {
              card.style.display = "none";
            }
          });

          if (summaryEl) {
            const minBDT = Math.round((minSum * expState.rate) / 1000);
            const maxBDT = Math.round((maxSum * expState.rate) / 1000);
            const loggedBDT = Math.round(loggedCityTHB * expState.rate);
            summaryEl.innerHTML =
              "Showing <strong>" +
              visibleCount +
              " of 21 days</strong> · Planned: <strong>฿" +
              formatNumber(minSum) +
              "–" +
              formatNumber(maxSum) +
              "</strong> (~৳" +
              minBDT +
              "k–" +
              maxBDT +
              "k) · Logged here: <strong>฿" +
              formatNumber(loggedCityTHB) +
              " (৳" +
              formatNumber(loggedBDT) +
              ")</strong>";
          }
        }

        filterPills.forEach((pill) => {
          pill.addEventListener("click", () => {
            currentCityFilter = pill.getAttribute("data-city-filter") || "all";
            filterPills.forEach((p) => p.classList.remove("active"));
            pill.classList.add("active");
            updateItineraryView();
          });
        });

        jumpButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const targetCity = btn.getAttribute("data-jump-btn") || "all";
            const matchingPill = document.querySelector(
              '[data-city-filter="' + targetCity + '"]'
            );
            if (matchingPill) matchingPill.click();
            const itinerarySec = document.getElementById("itinerary");
            if (itinerarySec) itinerarySec.scrollIntoView({ behavior: "smooth" });
          });
        });

        document.querySelectorAll("[data-complete-day]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const dayId = btn.getAttribute("data-complete-day");
            if (!dayId) return;
            doneDays[dayId] = !doneDays[dayId];
            saveDoneDays();
            updateItineraryView();
          });
        });

        if (compactBtn && daysContainer) {
          compactBtn.addEventListener("click", () => {
            const isCompact = daysContainer.classList.toggle("compact-mode");
            compactBtn.classList.toggle("active", isCompact);
            compactBtn.textContent = isCompact ? "Expand full details" : "Compact phone view";
          });
        }

        if (hideCompletedDaysBtn) {
          hideCompletedDaysBtn.addEventListener("click", () => {
            hideCompletedDays = !hideCompletedDays;
            hideCompletedDaysBtn.classList.toggle("active", hideCompletedDays);
            hideCompletedDaysBtn.textContent = hideCompletedDays
              ? "Show completed days"
              : "Hide completed days";
            updateItineraryView();
          });
        }

        // --- EXPENSE LOGGER RECALCULATION & TWO-WAY SYNC ---
        const targetBdtInput = document.getElementById("exp-target-bdt");
        const rateInput = document.getElementById("exp-rate-input");
        const includeFixedToggle = document.getElementById("include-fixed-toggle");
        const targetThbEquiv = document.getElementById("exp-target-thb-equiv");

        const kpiFixedBdt = document.getElementById("kpi-fixed-bdt");
        const kpiFixedThb = document.getElementById("kpi-fixed-thb");
        const kpiDaysLogged = document.getElementById("kpi-days-logged");
        const kpiDailyBdt = document.getElementById("kpi-daily-bdt");
        const kpiDailyThb = document.getElementById("kpi-daily-thb");
        const kpiRemainingCard = document.getElementById("kpi-remaining-card");
        const kpiRemainingBdt = document.getElementById("kpi-remaining-bdt");
        const kpiRemainingThb = document.getElementById("kpi-remaining-thb");
        const kpiBurnThb = document.getElementById("kpi-burn-thb");
        const kpiBurnBdt = document.getElementById("kpi-burn-bdt");

        const expBudgetBar = document.getElementById("exp-budget-bar");
        const expMeterLeftLabel = document.getElementById("exp-meter-left-label");
        const expMeterVarianceLabel = document.getElementById("exp-meter-variance-label");
        const topWalletPill = document.getElementById("top-wallet-pill");
        const mobNavWallet = document.getElementById("mob-nav-wallet");

        function updateExpenseUI() {
          const rate = parseFloat(expState.rate) || 3.67;
          const targetBDT = parseFloat(expState.targetBDT) || 320000;
          const targetTHB = targetBDT / rate;

          if (targetBdtInput && document.activeElement !== targetBdtInput) {
            targetBdtInput.value = targetBDT;
          }
          if (rateInput && document.activeElement !== rateInput) {
            rateInput.value = rate;
          }
          if (includeFixedToggle) {
            includeFixedToggle.checked = !!expState.includeFixed;
          }
          if (targetThbEquiv) {
            targetThbEquiv.textContent =
              "≈ ฿" + formatNumber(targetTHB) + " total budget at " + rate.toFixed(2) + " BDT/THB";
          }

          // Calculate Fixed Costs
          let fixedSumTHB = 0;
          document.querySelectorAll(".fixed-thb-input").forEach((inp) => {
            const fid = inp.getAttribute("data-fixed-id");
            const val = parseFloat(expState.fixed[fid]) || 0;
            if (document.activeElement !== inp) {
              inp.value = val;
            }
            fixedSumTHB += val;
            const bdtReadout = document.querySelector('[data-fixed-bdt="' + fid + '"]');
            if (bdtReadout) {
              bdtReadout.textContent = "≈ ৳" + formatNumber(val * rate);
            }
          });

          const countedFixedTHB = expState.includeFixed ? fixedSumTHB : 0;
          const countedFixedBDT = countedFixedTHB * rate;

          // Calculate Daily Logged Spend across 21 days
          let dailySumTHB = 0;
          let loggedDaysCount = 0;
          let plannedMidpointSumForLogged = 0;

          dayCards.forEach((card) => {
            const dNum = card.getAttribute("data-day-num");
            const minS = parseInt(card.getAttribute("data-min-spend") || "0", 10);
            const maxS = parseInt(card.getAttribute("data-max-spend") || "0", 10);
            const midpoint = Math.round((minS + maxS) / 2);

            const rawVal = expState.dailyTHB[dNum];
            const hasVal = rawVal !== undefined && rawVal !== "" && !isNaN(parseFloat(rawVal));
            const valTHB = hasVal ? parseFloat(rawVal) : 0;
            const noteStr = expState.dailyNotes[dNum] || "";

            // Sync inline inputs on Day Card
            const inlineInp = document.querySelector('[data-exp-day="' + dNum + '"]');
            if (inlineInp && document.activeElement !== inlineInp) {
              inlineInp.value = hasVal ? valTHB : "";
            }
            const inlineNote = document.querySelector('[data-note-day="' + dNum + '"]');
            if (inlineNote && document.activeElement !== inlineNote) {
              inlineNote.value = noteStr;
            }

            // Sync Ledger Table inputs
            const ledgerInp = document.querySelector('[data-ledger-day="' + dNum + '"]');
            if (ledgerInp && document.activeElement !== ledgerInp) {
              ledgerInp.value = hasVal ? valTHB : "";
            }
            const ledgerNote = document.querySelector('[data-ledger-note="' + dNum + '"]');
            if (ledgerNote && document.activeElement !== ledgerNote) {
              ledgerNote.value = noteStr;
            }

            const inlineBadge = document.querySelector('[data-exp-badge="' + dNum + '"]');
            const ledgerBdtCell = document.querySelector('[data-ledger-bdt="' + dNum + '"]');
            const ledgerDiffCell = document.querySelector('[data-ledger-diff="' + dNum + '"]');

            if (hasVal && valTHB >= 0) {
              dailySumTHB += valTHB;
              loggedDaysCount++;
              plannedMidpointSumForLogged += midpoint;
              const valBDT = valTHB * rate;

              if (ledgerBdtCell) {
                ledgerBdtCell.textContent = "৳" + formatNumber(valBDT);
              }

              let statusClass = "good";
              let statusText = "Within plan";
              if (valTHB < minS) {
                statusClass = "good";
                statusText = "฿" + formatNumber(minS - valTHB) + " under min";
              } else if (valTHB > maxS) {
                statusClass = "over";
                statusText = "+฿" + formatNumber(valTHB - maxS) + " over max";
              }

              if (inlineBadge) {
                inlineBadge.className = "inline-exp-status " + statusClass;
                inlineBadge.textContent =
                  "৳" + formatNumber(valBDT) + " · " + statusText;
              }
              if (ledgerDiffCell) {
                ledgerDiffCell.innerHTML =
                  '<span class="status-pill ' + statusClass + '">' + statusText + "</span>";
              }
            } else {
              if (inlineBadge) {
                inlineBadge.className = "inline-exp-status";
                inlineBadge.textContent = "Not logged yet";
              }
              if (ledgerBdtCell) ledgerBdtCell.textContent = "—";
              if (ledgerDiffCell) {
                ledgerDiffCell.innerHTML = '<span class="status-pill neutral">Unlogged</span>';
              }
            }
          });

          const dailySumBDT = dailySumTHB * rate;
          const totalSpentTHB = countedFixedTHB + dailySumTHB;
          const totalSpentBDT = totalSpentTHB * rate;
          const remainingBDT = targetBDT - totalSpentBDT;
          const remainingTHB = remainingBDT / rate;
          const remainingDays = Math.max(1, 21 - loggedDaysCount);
          const safeDailyTHB = remainingTHB > 0 ? remainingTHB / remainingDays : 0;
          const safeDailyBDT = safeDailyTHB * rate;

          // Update KPI Cards
          if (kpiFixedBdt) kpiFixedBdt.textContent = "৳" + formatNumber(countedFixedBDT);
          if (kpiFixedThb) {
            kpiFixedThb.textContent = expState.includeFixed
              ? "฿" + formatNumber(countedFixedTHB) + " (Flights, EDC, Hostels)"
              : "Excluded from calculation (Daily-only mode)";
          }
          if (kpiDaysLogged) kpiDaysLogged.textContent = loggedDaysCount + "/21";
          if (kpiDailyBdt) kpiDailyBdt.textContent = "৳" + formatNumber(dailySumBDT);
          if (kpiDailyThb) {
            kpiDailyThb.textContent =
              "฿" + formatNumber(dailySumTHB) + " spent across " + loggedDaysCount + " logged days";
          }

          if (kpiRemainingBdt) {
            kpiRemainingBdt.textContent =
              (remainingBDT < 0 ? "-৳" : "৳") + formatNumber(Math.abs(remainingBDT));
            kpiRemainingBdt.className =
              "kpi-val " + (remainingBDT >= 0 ? "emerald-text" : "danger-text");
          }
          if (kpiRemainingThb) {
            kpiRemainingThb.textContent =
              (remainingTHB < 0 ? "-฿" : "฿") +
              formatNumber(Math.abs(remainingTHB)) +
              (remainingBDT >= 0 ? " remaining in budget" : " over target budget");
          }
          if (kpiRemainingCard) {
            kpiRemainingCard.classList.toggle("over-budget-card", remainingBDT < 0);
          }

          if (kpiBurnThb) {
            kpiBurnThb.textContent =
              loggedDaysCount >= 21
                ? "Trip Complete"
                : "฿" + formatNumber(safeDailyTHB) + " / day";
          }
          if (kpiBurnBdt) {
            kpiBurnBdt.textContent =
              loggedDaysCount >= 21
                ? "All 21 days logged"
                : "≈ ৳" +
                  formatNumber(safeDailyBDT) +
                  "/day across " +
                  (21 - loggedDaysCount) +
                  " remaining days";
          }

          // Update Progress Bar & Variance
          const spentPct = Math.min(100, Math.max(0, Math.round((totalSpentBDT / targetBDT) * 100)));
          if (expBudgetBar) {
            expBudgetBar.style.width = spentPct + "%";
            expBudgetBar.classList.toggle("over-bar", remainingBDT < 0);
          }
          if (expMeterLeftLabel) {
            expMeterLeftLabel.textContent =
              "Total Spent: ৳" +
              formatNumber(totalSpentBDT) +
              " (฿" +
              formatNumber(totalSpentTHB) +
              " · " +
              spentPct +
              "% of target)";
          }
          if (expMeterVarianceLabel) {
            if (loggedDaysCount === 0) {
              expMeterVarianceLabel.textContent =
                "Log any day's THB spend to see variance vs. planned midpoint";
            } else {
              const diffTHB = dailySumTHB - plannedMidpointSumForLogged;
              const diffBDT = Math.abs(diffTHB) * rate;
              expMeterVarianceLabel.textContent =
                diffTHB <= 0
                  ? "✅ ฿" +
                    formatNumber(Math.abs(diffTHB)) +
                    " (৳" +
                    formatNumber(diffBDT) +
                    ") under planned midpoint for logged days"
                  : "⚠️ +฿" +
                    formatNumber(diffTHB) +
                    " (৳" +
                    formatNumber(diffBDT) +
                    ") above planned midpoint for logged days";
            }
          }

          // Update Topbar & Mobile Bottom Nav Pills
          const shortRemK = (remainingBDT / 1000).toFixed(1);
          if (topWalletPill) {
            topWalletPill.textContent =
              (remainingBDT < 0 ? "-৳" : "৳") + Math.abs(parseFloat(shortRemK)) + "k left";
          }
          if (mobNavWallet) {
            mobNavWallet.textContent =
              (remainingBDT < 0 ? "-৳" : "৳") + Math.round(Math.abs(remainingBDT) / 1000) + "k left";
          }

          updateItineraryView();
        }

        // Bind Target BDT, Rate, and Fixed Cost listeners
        if (targetBdtInput) {
          targetBdtInput.addEventListener("input", (e) => {
            expState.targetBDT = parseFloat(e.target.value) || 0;
            saveExpState();
            updateExpenseUI();
          });
        }

        if (rateInput) {
          rateInput.addEventListener("input", (e) => {
            expState.rate = parseFloat(e.target.value) || 3.67;
            saveExpState();
            updateExpenseUI();
          });
        }

        if (includeFixedToggle) {
          includeFixedToggle.addEventListener("change", (e) => {
            expState.includeFixed = e.target.checked;
            saveExpState();
            updateExpenseUI();
          });
        }

        document.querySelectorAll(".fixed-thb-input").forEach((inp) => {
          inp.addEventListener("input", (e) => {
            const fid = inp.getAttribute("data-fixed-id");
            expState.fixed[fid] = parseFloat(e.target.value) || 0;
            saveExpState();
            updateExpenseUI();
          });
        });

        // Bind Inline Day Card & Ledger Table THB/Note inputs
        function handleDaySpendInput(dayNum, valueStr) {
          if (valueStr === "" || valueStr === null) {
            delete expState.dailyTHB[dayNum];
          } else {
            expState.dailyTHB[dayNum] = Math.max(0, parseFloat(valueStr) || 0);
          }
          saveExpState();
          updateExpenseUI();
        }

        function handleDayNoteInput(dayNum, noteStr) {
          expState.dailyNotes[dayNum] = noteStr;
          saveExpState();
          updateExpenseUI();
        }

        document.querySelectorAll(".day-thb-input").forEach((inp) => {
          inp.addEventListener("input", (e) => {
            handleDaySpendInput(inp.getAttribute("data-exp-day"), e.target.value);
          });
        });

        document.querySelectorAll(".ledger-thb-input").forEach((inp) => {
          inp.addEventListener("input", (e) => {
            handleDaySpendInput(inp.getAttribute("data-ledger-day"), e.target.value);
          });
        });

        document.querySelectorAll(".day-note-input").forEach((inp) => {
          inp.addEventListener("input", (e) => {
            handleDayNoteInput(inp.getAttribute("data-note-day"), e.target.value);
          });
        });

        document.querySelectorAll(".ledger-note-input").forEach((inp) => {
          inp.addEventListener("input", (e) => {
            handleDayNoteInput(inp.getAttribute("data-ledger-note"), e.target.value);
          });
        });

        // Demo Fill Planned Midpoints Button
        const fillEstBtn = document.getElementById("exp-fill-estimates-btn");
        if (fillEstBtn) {
          fillEstBtn.addEventListener("click", () => {
            dayCards.forEach((card) => {
              const dNum = card.getAttribute("data-day-num");
              const minS = parseInt(card.getAttribute("data-min-spend") || "0", 10);
              const maxS = parseInt(card.getAttribute("data-max-spend") || "0", 10);
              expState.dailyTHB[dNum] = Math.round((minS + maxS) / 2);
            });
            saveExpState();
            updateExpenseUI();
          });
        }

        // Clear Daily Logs Button
        const clearDailyBtn = document.getElementById("exp-clear-daily-btn");
        if (clearDailyBtn) {
          clearDailyBtn.addEventListener("click", () => {
            if (window.confirm("Clear all 21 daily THB spend logs and notes?")) {
              expState.dailyTHB = {};
              expState.dailyNotes = {};
              saveExpState();
              updateExpenseUI();
            }
          });
        }

        // Export CSV Button
        const exportCsvBtn = document.getElementById("exp-export-csv-btn");
        if (exportCsvBtn) {
          exportCsvBtn.addEventListener("click", () => {
            const rate = parseFloat(expState.rate) || 3.67;
            let csv = "Item/Day,Location/Category,Planned THB,Actual THB,Actual BDT,Notes\n";

            document.querySelectorAll(".fixed-thb-input").forEach((inp) => {
              const fid = inp.getAttribute("data-fixed-id");
              const val = parseFloat(expState.fixed[fid]) || 0;
              csv +=
                '"' +
                fid +
                '","Pre-Trip Fixed",0,' +
                val +
                "," +
                Math.round(val * rate) +
                ',""\n';
            });

            dayCards.forEach((card) => {
              const dNum = card.getAttribute("data-day-num");
              const minS = card.getAttribute("data-min-spend");
              const maxS = card.getAttribute("data-max-spend");
              const rawVal = expState.dailyTHB[dNum];
              const val = rawVal !== undefined && rawVal !== "" ? parseFloat(rawVal) : 0;
              const note = (expState.dailyNotes[dNum] || "").replace(/"/g, '""');
              csv +=
                '"Day ' +
                dNum +
                '","' +
                card.getAttribute("data-cities") +
                '","' +
                minS +
                "-" +
                maxS +
                '",' +
                val +
                "," +
                Math.round(val * rate) +
                ',"' +
                note +
                '"\n';
            });

            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "thailand-grand-tour-expenses.csv";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          });
        }

        // --- BOOKING & PACKING CHECKLIST ---
        const chkInputs = document.querySelectorAll(".chk-input");
        const chkRows = document.querySelectorAll(".chk-row");
        const chkTabs = document.querySelectorAll("[data-chk-filter]");
        const progressBar = document.getElementById("chk-progress-bar");
        const countLabel = document.getElementById("chk-count-label");
        const topProgressPill = document.getElementById("top-progress-pill");
        const mobNavChkCount = document.getElementById("mob-nav-chk-count");
        const hideDoneBtn = document.getElementById("chk-hide-done-btn");
        const resetBtn = document.getElementById("chk-reset-btn");

        let checkedState = {};
        let currentChkCat = "all";
        let hideCheckedItems = false;

        try {
          checkedState = JSON.parse(localStorage.getItem(CHK_STORAGE_KEY) || "{}");
        } catch (e) {
          checkedState = {};
        }

        function saveCheckedState() {
          try {
            localStorage.setItem(CHK_STORAGE_KEY, JSON.stringify(checkedState));
          } catch (e) {}
        }

        function updateChecklistUI() {
          const total = chkInputs.length;
          let completed = 0;

          chkRows.forEach((row) => {
            const id = row.getAttribute("data-chk-id");
            const cat = row.getAttribute("data-chk-cat");
            const input = row.querySelector(".chk-input");
            const isChecked = !!checkedState[id];

            if (input) input.checked = isChecked;
            row.classList.toggle("is-checked", isChecked);
            if (isChecked) completed++;

            const matchesCat = currentChkCat === "all" || cat === currentChkCat;
            const matchesHide = !hideCheckedItems || !isChecked;

            row.style.display = matchesCat && matchesHide ? "flex" : "none";
          });

          const pct = total > 0 ? Math.round((completed / total) * 100) : 0;
          if (progressBar) progressBar.style.width = pct + "%";
          if (countLabel) {
            countLabel.textContent =
              completed + " of " + total + " completed (" + pct + "%)";
          }
          if (topProgressPill) {
            topProgressPill.textContent = "Checklist · " + completed + "/" + total;
          }
          if (mobNavChkCount) {
            mobNavChkCount.textContent = completed + "/" + total + " Done";
          }
        }

        chkInputs.forEach((input) => {
          input.addEventListener("change", (e) => {
            const id = e.target.value;
            checkedState[id] = e.target.checked;
            saveCheckedState();
            updateChecklistUI();
          });
        });

        chkTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            currentChkCat = tab.getAttribute("data-chk-filter") || "all";
            chkTabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");
            updateChecklistUI();
          });
        });

        if (hideDoneBtn) {
          hideDoneBtn.addEventListener("click", () => {
            hideCheckedItems = !hideCheckedItems;
            hideDoneBtn.classList.toggle("active", hideCheckedItems);
            hideDoneBtn.textContent = hideCheckedItems ? "Show checked" : "Hide checked";
            updateChecklistUI();
          });
        }

        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            if (window.confirm("Reset all checked booking and packing items?")) {
              checkedState = {};
              saveCheckedState();
              updateChecklistUI();
            }
          });
        }

        // Initialize all views
        updateExpenseUI();
        updateChecklistUI();
      })();
    </script>

    <style>
      :root {
        --bg: #0c0f0d;
        --bg-elevated: #141916;
        --bg-card: #181f1b;
        --border: rgba(255, 255, 255, 0.1);
