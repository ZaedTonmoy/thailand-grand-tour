          <div class="emg-contact-card">
            <div class="emg-icon">🇧🇩</div>
            <div class="emg-info">
              <h3>Bangladesh Embassy Bangkok</h3>
              <p class="emg-phone"><a href="tel:+6623905107">+66 2 390 5107</a></p>
              <small>47/8 Soi Ekkamai 30, Sukhumvit 63, Bangkok (Near BTS Ekkamai).</small>
            </div>
          </div>
